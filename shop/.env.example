# Name des Shops (erscheint im Kopf und in Stripe)
SHOP_NAME=Meine Texte
# Öffentliche Adresse des Shops (ohne / am Ende) – wichtig für Stripe-Weiterleitungen
BASE_URL=http://localhost:3000
PORT=3000

# Passwort für /admin
ADMIN_PASSWORD=bitte-aendern
# Zufälliger langer Wert zum Signieren der Admin-Sitzung, z.B. `openssl rand -hex 32`
SESSION_SECRET=

# Stripe (https://dashboard.stripe.com/apikeys) – zum Testen sk_test_… verwenden
STRIPE_SECRET_KEY=
# Signatur-Secret des Webhooks (whsec_…), Endpunkt: BASE_URL/webhook
STRIPE_WEBHOOK_SECRET=

CURRENCY=eur
# Wie oft und wie lange ein Kauf heruntergeladen werden darf
DOWNLOAD_LIMIT=5
DOWNLOAD_DAYS=30
# Speicherort für Datenbank und Dateien
DATA_DIR=./data
