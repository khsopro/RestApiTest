{
  "name": "text-shop",
  "version": "1.0.0",
  "description": "Kleiner Online-Shop für digitale Texte (PDF/EPUB) mit Stripe-Zahlung",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env --watch src/server.js",
    "test": "node --no-warnings=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^4.22.3",
    "multer": "^2.4.0",
    "stripe": "^23.0.0"
  }
}
